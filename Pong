<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pong</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet">
<style>
  :root {
    --page: #eef1f4;
    --page-ink: #14263a;
    --page-muted: #5b6b7c;
    --table: #1b4f82;
    --table-deep: #123a62;
    --chalk: #f7f3ea;
    --left: #f7f3ea;
    --right: #ff6b5a;
    --ball: #ffa31a;
    --panel: rgba(10, 28, 48, 0.88);
    --font: "Bricolage Grotesque", "Avenir Next", "Segoe UI", system-ui, sans-serif;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --page: #0b1626;
      --page-ink: #eaf0f6;
      --page-muted: #8fa3b8;
    }
  }
  :root[data-theme="dark"] {
    --page: #0b1626;
    --page-ink: #eaf0f6;
    --page-muted: #8fa3b8;
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); height: 100%; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100%;
    background: var(--page);
    color: var(--page-ink);
    font-family: var(--font);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .wrap { width: min(100%, 940px); }
  .bar {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 10px; gap: 12px;
  }
  .bar h1 { margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .bar p { margin: 0; font-size: 0.9rem; color: var(--page-muted); }
  .stage {
    position: relative;
    border-radius: 18px;
    padding: 10px;
    background: linear-gradient(160deg, #0d2a47, #08182b);
    box-shadow: 0 18px 40px -18px rgba(8, 24, 43, 0.55), inset 0 0 0 1px rgba(255,255,255,0.06);
  }
  canvas {
    display: block; width: 100%; aspect-ratio: 900 / 560;
    border-radius: 10px; touch-action: none; cursor: none;
    background: var(--table);
  }
  .overlay {
    position: absolute; inset: 10px; border-radius: 10px;
    display: none; align-items: center; justify-content: center;
    background: rgba(8, 24, 43, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    padding: 12px;
  }
  .overlay.on { display: flex; }
  .card {
    width: min(100%, 420px);
    background: var(--panel);
    color: var(--chalk);
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,255,255,0.08);
    max-height: 100%;
    overflow-y: auto;
  }
  .card h2 { margin: 0 0 4px; font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .card .sub { margin: 0 0 18px; color: #b9c7d6; font-size: 0.95rem; }
  .group { margin: 14px 0; text-align: left; }
  .group > span { display: block; font-size: 0.85rem; color: #b9c7d6; margin-bottom: 6px; }
  .seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; background: rgba(255,255,255,0.08); padding: 4px; border-radius: 12px; }
  .seg button {
    font: inherit; font-weight: 600; font-size: 0.95rem;
    border: 0; background: transparent; color: var(--chalk);
    padding: 9px 6px; border-radius: 9px; cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .seg button[aria-pressed="true"] { background: var(--chalk); color: #0d2a47; }
  .seg button:hover:not([aria-pressed="true"]) { background: rgba(255,255,255,0.12); }
  .btn {
    font: inherit; font-weight: 800; font-size: 1.05rem;
    width: 100%; margin-top: 8px; padding: 13px 16px;
    border: 0; border-radius: 12px; cursor: pointer;
    background: var(--ball); color: #2a1700;
    transition: transform 0.12s, filter 0.15s;
  }
  .btn:hover { filter: brightness(1.07); }
  .btn:active { transform: translateY(1px) scale(0.99); }
  .btn.ghost { background: rgba(255,255,255,0.1); color: var(--chalk); font-weight: 600; }
  .keys { margin: 14px 0 0; font-size: 0.82rem; color: #9db0c4; line-height: 1.5; }
  kbd {
    font-family: inherit; font-size: 0.78rem; font-weight: 600;
    background: rgba(255,255,255,0.12); border-radius: 5px; padding: 1px 6px;
  }
  .big { font-size: 3.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 6px 0 4px; }
  .controls { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; gap: 10px; flex-wrap: wrap; }
  .controls .hint { font-size: 0.85rem; color: var(--page-muted); }
  .controls div { display: flex; gap: 8px; }
  .chip {
    font: inherit; font-size: 0.88rem; font-weight: 600;
    background: transparent; color: var(--page-ink);
    border: 1.5px solid color-mix(in srgb, var(--page-ink) 25%, transparent);
    border-radius: 999px; padding: 6px 14px; cursor: pointer;
  }
  .chip:hover { background: color-mix(in srgb, var(--page-ink) 8%, transparent); }
  button:focus-visible { outline: 3px solid #7cc4ff; outline-offset: 2px; }
  @media (max-width: 520px) {
    body { padding: 10px; }
    .card { padding: 18px; }
    .card h2 { font-size: 2rem; }
    .bar p { display: none; }
  }
</style>
</head>
<body>
<main class="wrap">
  <div class="bar">
    <h1>Pong</h1>
    <p>First to 7 takes the match</p>
  </div>

  <div class="stage" id="stage">
    <canvas id="c" aria-label="Pong game board" role="img"></canvas>

    <div class="overlay on" id="ov-menu">
      <div class="card">
        <h2>Pong</h2>
        <p class="sub">Rally fast, aim with the edge of your paddle.</p>
        <div class="group">
          <span>Players</span>
          <div class="seg" id="seg-mode">
            <button type="button" data-v="1" aria-pressed="true">You vs computer</button>
            <button type="button" data-v="2" aria-pressed="false">Two players</button>
          </div>
        </div>
        <div class="group" id="grp-diff">
          <span>Computer skill</span>
          <div class="seg" id="seg-diff">
            <button type="button" data-v="easy" aria-pressed="false">Easy</button>
            <button type="button" data-v="medium" aria-pressed="true">Medium</button>
            <button type="button" data-v="hard" aria-pressed="false">Hard</button>
          </div>
        </div>
        <button class="btn" id="btn-start" type="button">Start match</button>
        <p class="keys" id="keys-help"></p>
      </div>
    </div>

    <div class="overlay" id="ov-pause">
      <div class="card">
        <h2>Paused</h2>
        <p class="sub">Catch your breath.</p>
        <button class="btn" id="btn-resume" type="button">Resume</button>
        <button class="btn ghost" id="btn-quit" type="button">Back to menu</button>
      </div>
    </div>

    <div class="overlay" id="ov-over">
      <div class="card">
        <p class="sub" id="over-sub" style="margin-bottom:0"></p>
        <div class="big" id="over-title"></div>
        <p class="sub" id="over-score"></p>
        <button class="btn" id="btn-again" type="button">Play again</button>
        <button class="btn ghost" id="btn-menu" type="button">Change settings</button>
      </div>
    </div>
  </div>

  <div class="controls">
    <span class="hint" id="hint">Move with your mouse, finger, or the keyboard.</span>
    <div>
      <button class="chip" id="btn-sound" type="button" aria-pressed="true">Sound on</button>
      <button class="chip" id="btn-pause" type="button">Pause</button>
    </div>
  </div>
</main>

<script>
(() => {
  "use strict";

  // ---------- Constants ----------
  const W = 900, H = 560;
  const PW = 14, PH = 96, PAD_X = 30, BR = 8;
  const PADDLE_SPEED = 640;
  const WIN = 7;
  const BALL_START = 460, BALL_MAX = 1500, BALL_GAIN = 1.12;
  const MAX_ANGLE = Math.PI * 0.30; // 54 degrees
  const LEVELS = {
    easy:   { speed: 330, err: 1.15, reach: 0.50 },
    medium: { speed: 450, err: 0.60, reach: 0.38 },
    hard:   { speed: 620, err: 0.20, reach: 0.22 }
  };
  const COLORS = { table: "#1b4f82", deep: "#123a62", chalk: "#f7f3ea", left: "#f7f3ea", right: "#ff6b5a", ball: "#ffa31a" };
  const FONT = '"Bricolage Grotesque", "Avenir Next", "Segoe UI", system-ui, sans-serif';
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---------- DOM ----------
  const $ = id => document.getElementById(id);
  const canvas = $("c"), ctx = canvas.getContext("2d");
  const ovMenu = $("ov-menu"), ovPause = $("ov-pause"), ovOver = $("ov-over");

  // ---------- State ----------
  const settings = { mode: 1, diff: "medium", sound: true };
  let state = "menu"; // menu | serve | play | paused | over
  let scores = [0, 0];
  let serveTimer = 0, serveDir = 1, lastWinner = -1;
  let shake = 0, flash = 0;
  const keys = new Set();
  const paddles = [
    { x: PAD_X, y: H / 2 - PH / 2, glow: 0 },
    { x: W - PAD_X - PW, y: H / 2 - PH / 2, glow: 0 }
  ];
  const ball = { x: W / 2, y: H / 2, vx: 0, vy: 0, speed: BALL_START, trail: [] };
  let particles = [];
  let cpuTargetErr = 0;
  let scorePop = [0, 0];

  // ---------- Audio ----------
  let actx = null;
  function beep(freq, dur, type = "square", vol = 0.06, slide = 0) {
    if (!settings.sound) return;
    try {
      actx = actx || new (window.AudioContext || window.webkitAudioContext)();
      if (actx.state === "suspended") actx.resume();
      const o = actx.createOscillator(), g = actx.createGain();
      o.type = type;
      o.frequency.setValueAtTime(freq, actx.currentTime);
      if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(40, freq + slide), actx.currentTime + dur);
      g.gain.setValueAtTime(vol, actx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + dur);
      o.connect(g); g.connect(actx.destination);
      o.start(); o.stop(actx.currentTime + dur);
    } catch (e) { /* audio unavailable */ }
  }
  const sfx = {
    paddle: s => beep(380 + s * 260, 0.08, "square", 0.05),
    wall:   () => beep(220, 0.06, "triangle", 0.07),
    score:  () => { beep(300, 0.25, "sawtooth", 0.05, -180); },
    win:    () => { [523, 659, 784, 1046].forEach((f, i) => setTimeout(() => beep(f, 0.18, "triangle", 0.07), i * 110)); },
    start:  () => beep(660, 0.1, "triangle", 0.06)
  };

  // ---------- Layout / resize ----------
  let scale = 1;
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
    const cssW = canvas.clientWidth;
    canvas.width = Math.round(cssW * dpr);
    canvas.height = Math.round(cssW * (H / W) * dpr);
    scale = canvas.width / W;
  }
  window.addEventListener("resize", resize);

  // ---------- Helpers ----------
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const rand = (a, b) => a + Math.random() * (b - a);

  function resetPaddles() {
    paddles.forEach(p => { p.y = H / 2 - PH / 2; p.glow = 0; });
  }

  function newMatch() {
    scores = [0, 0];
    lastWinner = -1;
    resetPaddles();
    serveDir = Math.random() < 0.5 ? 1 : -1;
    startServe();
    hideAll();
    sfx.start();
  }

  function startServe() {
    state = "serve";
    serveTimer = 0.95;
    ball.x = W / 2; ball.y = H / 2; ball.vx = 0; ball.vy = 0;
    ball.speed = BALL_START; ball.trail.length = 0;
    cpuTargetErr = (Math.random() - 0.5) * PH * LEVELS[settings.diff].err;
  }

  function launch() {
    const a = rand(-0.45, 0.45);
    ball.vx = Math.cos(a) * ball.speed * serveDir;
    ball.vy = Math.sin(a) * ball.speed;
    state = "play";
  }

  function burst(x, y, color, n, spread) {
    if (reduceMotion) n = Math.ceil(n / 3);
    for (let i = 0; i < n; i++) {
      const a = rand(0, Math.PI * 2), s = rand(60, spread);
      particles.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: rand(0.3, 0.7), max: 0.7, color, r: rand(1.5, 3.5) });
    }
  }

  // ---------- Overlays ----------
  function hideAll() { [ovMenu, ovPause, ovOver].forEach(o => o.classList.remove("on")); }
  function show(o) { hideAll(); o.classList.add("on"); }

  function updateKeysHelp() {
    $("keys-help").innerHTML = settings.mode === 1
      ? "Move with <kbd>W</kbd> <kbd>S</kbd>, the arrow keys, your mouse, or touch. Pause with <kbd>Space</kbd>."
      : "Left player: <kbd>W</kbd> <kbd>S</kbd> &nbsp; Right player: <kbd>↑</kbd> <kbd>↓</kbd>. On touch screens, use each half of the board. Pause with <kbd>Space</kbd>.";
    $("grp-diff").style.display = settings.mode === 1 ? "" : "none";
  }

  function bindSeg(id, key, parse) {
    const seg = $(id);
    seg.addEventListener("click", e => {
      const b = e.target.closest("button");
      if (!b) return;
      settings[key] = parse(b.dataset.v);
      seg.querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
      updateKeysHelp();
    });
  }
  bindSeg("seg-mode", "mode", Number);
  bindSeg("seg-diff", "diff", String);

  function gameOver(winner) {
    state = "over";
    lastWinner = winner;
    const youWin = settings.mode === 1 ? winner === 0 : true;
    $("over-sub").textContent = settings.mode === 1 ? (winner === 0 ? "Nice rallying." : "The computer took this one.") : "Match over";
    $("over-title").textContent = settings.mode === 1 ? (winner === 0 ? "You win" : "You lose") : (winner === 0 ? "Left player wins" : "Right player wins");
    $("over-score").textContent = scores[0] + " to " + scores[1];
    $("over-title").style.color = winner === 0 ? COLORS.left : COLORS.right;
    if (youWin) sfx.win(); else sfx.score();
    setTimeout(() => { if (state === "over") show(ovOver); $("btn-again").focus({ preventScroll: true }); }, 700);
  }

  function pause() {
    if (state !== "play" && state !== "serve") return;
    prevState = state; state = "paused"; show(ovPause); $("btn-resume").focus({ preventScroll: true });
  }
  let prevState = "play";
  function resume() { if (state !== "paused") return; state = prevState; hideAll(); last = performance.now(); }
  function togglePause() { state === "paused" ? resume() : pause(); }

  $("btn-start").addEventListener("click", newMatch);
  $("btn-again").addEventListener("click", newMatch);
  $("btn-resume").addEventListener("click", resume);
  $("btn-pause").addEventListener("click", togglePause);
  $("btn-quit").addEventListener("click", () => { state = "menu"; show(ovMenu); });
  $("btn-menu").addEventListener("click", () => { state = "menu"; show(ovMenu); });
  $("btn-sound").addEventListener("click", e => {
    settings.sound = !settings.sound;
    e.currentTarget.textContent = settings.sound ? "Sound on" : "Sound off";
    e.currentTarget.setAttribute("aria-pressed", String(settings.sound));
  });
  document.addEventListener("visibilitychange", () => { if (document.hidden) pause(); });
  window.addEventListener("blur", pause);

  // ---------- Input ----------
  window.addEventListener("keydown", e => {
    const k = e.code;
    if (["ArrowUp", "ArrowDown", "Space"].includes(k) && state !== "menu" && state !== "over" && state !== "paused") e.preventDefault();
    if (k === "Space" || k === "KeyP" || k === "Escape") {
      if (state === "play" || state === "serve" || state === "paused") { e.preventDefault(); togglePause(); }
      return;
    }
    keys.add(k);
  });
  window.addEventListener("keyup", e => keys.delete(e.code));

  function pointerY(e) {
    const r = canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * W, y: ((e.clientY - r.top) / r.height) * H };
  }
  function pointerMove(e) {
    if (state === "menu" || state === "over" || state === "paused") return;
    const p = pointerY(e);
    const idx = settings.mode === 1 ? 0 : (p.x < W / 2 ? 0 : 1);
    paddles[idx].y = clamp(p.y - PH / 2, 0, H - PH);
  }
  canvas.addEventListener("pointermove", pointerMove);
  canvas.addEventListener("pointerdown", e => { canvas.setPointerCapture(e.pointerId); pointerMove(e); });

  // ---------- Update ----------
  function predictY(p) {
    // Where the ball will be when it reaches paddle p's face, folding off the walls.
    const tx = p === 1 ? paddles[1].x - BR : paddles[0].x + PW + BR;
    const t = (tx - ball.x) / ball.vx;
    if (t < 0) return ball.y;
    const range = H - 2 * BR;
    let y = ball.y + ball.vy * t - BR;
    y = ((y % (2 * range)) + 2 * range) % (2 * range);
    if (y > range) y = 2 * range - y;
    return y + BR;
  }

  function movePaddles(dt) {
    let up0 = keys.has("KeyW"), dn0 = keys.has("KeyS");
    let up1 = keys.has("ArrowUp"), dn1 = keys.has("ArrowDown");
    if (settings.mode === 1) { up0 = up0 || up1; dn0 = dn0 || dn1; }
    paddles[0].y += ((dn0 ? 1 : 0) - (up0 ? 1 : 0)) * PADDLE_SPEED * dt;
    if (settings.mode === 2) paddles[1].y += ((dn1 ? 1 : 0) - (up1 ? 1 : 0)) * PADDLE_SPEED * dt;
    else {
      // computer
      const lv = LEVELS[settings.diff];
      let target = H / 2;
      if (state === "play" && ball.vx > 0 && ball.x > W * lv.reach) target = predictY(1) + cpuTargetErr;
      else if (state === "play" && ball.vx > 0) target = ball.y;
      const c = paddles[1].y + PH / 2;
      const d = target - c;
      const step = lv.speed * dt;
      if (Math.abs(d) > 6) paddles[1].y += clamp(d, -step, step);
    }
    paddles.forEach(p => { p.y = clamp(p.y, 0, H - PH); p.glow = Math.max(0, p.glow - dt * 4); });
  }

  function hitPaddle(i) {
    const p = paddles[i];
    const rel = clamp((ball.y - (p.y + PH / 2)) / (PH / 2), -1, 1);
    const ang = rel * MAX_ANGLE;
    ball.speed = Math.min(ball.speed * BALL_GAIN, BALL_MAX);
    const dir = i === 0 ? 1 : -1;
    ball.vx = Math.cos(ang) * ball.speed * dir;
    ball.vy = Math.sin(ang) * ball.speed;
    ball.x = i === 0 ? p.x + PW + BR : p.x - BR;
    p.glow = 1;
    shake = Math.min(6, shake + 2.5);
    burst(ball.x, ball.y, i === 0 ? COLORS.left : COLORS.right, 12, 240);
    sfx.paddle((ball.speed - BALL_START) / (BALL_MAX - BALL_START));
    if (i === 0) cpuTargetErr = (Math.random() - 0.5) * PH * LEVELS[settings.diff].err;
  }

  function score(i) {
    scores[i]++;
    scorePop[i] = 1;
    flash = 1;
    shake = 8;
    burst(i === 0 ? W - 4 : 4, ball.y, i === 0 ? COLORS.left : COLORS.right, 36, 420);
    sfx.score();
    if (scores[i] >= WIN) { state = "over"; ball.vx = ball.vy = 0; gameOver(i); return; }
    serveDir = i === 0 ? 1 : -1; // serve toward the player who was scored on
    startServe();
  }

  function stepBall(dt) {
    const n = 4, h = dt / n;
    for (let s = 0; s < n; s++) {
      ball.x += ball.vx * h; ball.y += ball.vy * h;
      if (ball.y < BR) { ball.y = BR; ball.vy = Math.abs(ball.vy); wallHit(); }
      else if (ball.y > H - BR) { ball.y = H - BR; ball.vy = -Math.abs(ball.vy); wallHit(); }
      for (let i = 0; i < 2; i++) {
        const p = paddles[i];
        const towards = i === 0 ? ball.vx < 0 : ball.vx > 0;
        if (towards && ball.x + BR >= p.x && ball.x - BR <= p.x + PW && ball.y + BR >= p.y && ball.y - BR <= p.y + PH) {
          // Don't catch the ball if it's already past the paddle's far edge.
          const behind = i === 0 ? ball.x < p.x : ball.x > p.x + PW;
          if (!behind) hitPaddle(i);
        }
      }
      if (ball.x < -BR * 2) { score(1); return; }
      if (ball.x > W + BR * 2) { score(0); return; }
    }
  }
  function wallHit() {
    burst(ball.x, ball.y, COLORS.chalk, 5, 140);
    sfx.wall();
  }

  function update(dt) {
    scorePop = scorePop.map(v => Math.max(0, v - dt * 3));
    shake = Math.max(0, shake - dt * 24);
    flash = Math.max(0, flash - dt * 3);
    particles = particles.filter(p => (p.life -= dt) > 0);
    particles.forEach(p => { p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= 0.96; p.vy *= 0.96; });

    if (state === "menu") {
      // attract mode: ball idles in the middle
      return;
    }
    if (state === "paused" || state === "over") { return; }

    movePaddles(dt);
    if (state === "serve") {
      serveTimer -= dt;
      if (serveTimer <= 0) launch();
    } else if (state === "play") {
      ball.trail.push({ x: ball.x, y: ball.y });
      if (ball.trail.length > 14) ball.trail.shift();
      stepBall(dt);
    }
  }

  // ---------- Render ----------
  function roundRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function drawTable() {
    const g = ctx.createRadialGradient(W / 2, H / 2, 60, W / 2, H / 2, W * 0.62);
    g.addColorStop(0, "#2362a0");
    g.addColorStop(1, COLORS.deep);
    ctx.fillStyle = g;
    ctx.fillRect(-20, -20, W + 40, H + 40);

    // table edge lines
    ctx.strokeStyle = "rgba(247,243,234,0.85)";
    ctx.lineWidth = 4;
    ctx.strokeRect(14, 14, W - 28, H - 28);

    // centre line (the "net")
    ctx.fillStyle = "rgba(247,243,234,0.55)";
    for (let y = 22; y < H - 22; y += 26) ctx.fillRect(W / 2 - 2, y, 4, 14);

    // service line across the middle of each half
    ctx.strokeStyle = "rgba(247,243,234,0.14)";
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(14, H / 2); ctx.lineTo(W - 14, H / 2); ctx.stroke();

    // goal flash
    if (flash > 0) {
      ctx.fillStyle = `rgba(255,255,255,${flash * 0.12})`;
      ctx.fillRect(0, 0, W, H);
    }
  }

  function drawScores() {
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    [[0, W * 0.27, COLORS.left], [1, W * 0.73, COLORS.right]].forEach(([i, x, col]) => {
      const pop = scorePop[i];
      const size = 120 + pop * 26;
      ctx.font = `800 ${size}px ${FONT}`;
      ctx.fillStyle = "rgba(247,243,234,0.10)";
      ctx.fillText(String(scores[i]), x, H / 2 + 4);
      ctx.lineWidth = 2;
      ctx.strokeStyle = pop > 0 ? col : "rgba(247,243,234,0.28)";
      ctx.strokeText(String(scores[i]), x, H / 2 + 4);
    });
    // player labels
    ctx.font = `600 15px ${FONT}`;
    ctx.fillStyle = "rgba(247,243,234,0.6)";
    ctx.fillText(settings.mode === 1 ? "You" : "Left", W * 0.27, 44);
    ctx.fillText(settings.mode === 1 ? "Computer" : "Right", W * 0.73, 44);
  }

  function drawPaddle(i) {
    const p = paddles[i];
    const col = i === 0 ? COLORS.left : COLORS.right;
    ctx.save();
    ctx.shadowColor = "rgba(0,0,0,0.35)";
    ctx.shadowBlur = 14; ctx.shadowOffsetY = 6;
    ctx.fillStyle = col;
    roundRect(p.x, p.y, PW, PH, 7); ctx.fill();
    ctx.restore();
    if (p.glow > 0) {
      ctx.save();
      ctx.globalAlpha = p.glow * 0.7;
      ctx.shadowColor = col; ctx.shadowBlur = 28;
      ctx.fillStyle = col;
      roundRect(p.x, p.y, PW, PH, 7); ctx.fill();
      ctx.restore();
    }
    // grip stripe
    ctx.fillStyle = "rgba(10,28,48,0.25)";
    ctx.fillRect(p.x + PW / 2 - 1, p.y + 12, 2, PH - 24);
  }

  function drawBall() {
    // trail
    for (let i = 0; i < ball.trail.length; i++) {
      const t = ball.trail[i], f = (i + 1) / ball.trail.length;
      ctx.fillStyle = `rgba(255,163,26,${f * 0.28})`;
      ctx.beginPath(); ctx.arc(t.x, t.y, BR * f * 0.9, 0, Math.PI * 2); ctx.fill();
    }
    // shadow on the table
    ctx.fillStyle = "rgba(0,0,0,0.25)";
    ctx.beginPath(); ctx.ellipse(ball.x + 4, ball.y + 9, BR * 0.95, BR * 0.5, 0, 0, Math.PI * 2); ctx.fill();

    let r = BR;
    if (state === "serve") r = BR + Math.sin(performance.now() / 90) * 1.6 + (1 - serveTimer) * 0;
    const g = ctx.createRadialGradient(ball.x - 3, ball.y - 3, 1, ball.x, ball.y, r + 2);
    g.addColorStop(0, "#ffd48a");
    g.addColorStop(0.45, COLORS.ball);
    g.addColorStop(1, "#d97800");
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(ball.x, ball.y, r, 0, Math.PI * 2); ctx.fill();
  }

  function drawParticles() {
    particles.forEach(p => {
      ctx.globalAlpha = clamp(p.life / p.max, 0, 1);
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
    });
    ctx.globalAlpha = 1;
  }

  function drawServeHint() {
    if (state !== "serve") return;
    const dir = serveDir;
    const a = clamp(serveTimer / 0.95, 0, 1);
    ctx.strokeStyle = `rgba(247,243,234,${0.55 * a})`;
    ctx.lineWidth = 3; ctx.lineCap = "round"; ctx.lineJoin = "round";
    ctx.beginPath();
    const x0 = W / 2 + dir * 30, x1 = W / 2 + dir * 54;
    ctx.moveTo(x0, H / 2 - 12); ctx.lineTo(x1, H / 2); ctx.lineTo(x0, H / 2 + 12);
    ctx.stroke();
  }

  function render() {
    ctx.setTransform(scale, 0, 0, scale, 0, 0);
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    if (shake > 0 && !reduceMotion) ctx.translate(rand(-shake, shake) * 0.5, rand(-shake, shake) * 0.5);
    drawTable();
    drawScores();
    drawServeHint();
    drawParticles();
    drawPaddle(0); drawPaddle(1);
    drawBall();
    ctx.restore();
  }

  // ---------- Loop ----------
  let last = performance.now();
  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.033);
    last = now;
    update(dt);
    render();
    requestAnimationFrame(frame);
  }

  // Idle ball animation behind the menu
  (function attract() {
    ball.x = W / 2; ball.y = H / 2;
  })();

  updateKeysHelp();
  resize();
  if (document.fonts && document.fonts.load) document.fonts.load('800 120px "Bricolage Grotesque"').catch(() => {});
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
